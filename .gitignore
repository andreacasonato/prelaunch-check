node_modules/
# Build output of this repo's own packages only (fixtures contain deliberate dist/ folders)
/packages/*/dist/
/apps/*/dist/
/coverage/
*.tgz
.DS_Store

# Environment files: ignore all, keep the example
.env*
!.env.example

# Scanner output
prelaunch-check-report/

# Playwright
test-results/
playwright-report/

# Deliberately vulnerable fixture projects need their .env files committed
!fixtures/**/.env*

# Private planning docs: kept locally, never published
/docs/

# Copied into the CLI package by prepack
/packages/cli/README.md
/packages/cli/LICENSE
/packages/cli/NOTICE

# Playwright output
/apps/web/test-results/
/apps/web/playwright-report/
